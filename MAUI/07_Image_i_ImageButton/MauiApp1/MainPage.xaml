<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.MainPage"
             x:Name="thisPage"
             BindingContext="{x:Reference thisPage}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label
            HorizontalTextAlignment="Center"
            FontSize="Title"
            Text="Kliknij konkretną dynie" 
            Margin="20"
            Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="3"/>

        <ImageButton Grid.Column="0" Grid.Row="0"
                     AutomationId="0" Clicked="PumpkinClicked"
                     Source="pumpkin0.png"/>
        <ImageButton Grid.Column="1" Grid.Row="0"
                     AutomationId="1" Clicked="PumpkinClicked"
                     Source="pumpkin0.png"/>
        <ImageButton Grid.Column="2" Grid.Row="0"
                     AutomationId="2" Clicked="PumpkinClicked"
                     Source="pumpkin0.png"/>
        <ImageButton Grid.Column="0" Grid.Row="1"
                     AutomationId="3" Clicked="PumpkinClicked"
                     Source="pumpkin0.png"/>
        <ImageButton Grid.Column="1" Grid.Row="1"
                     AutomationId="4" Clicked="PumpkinClicked"
                     Source="pumpkin0.png"/>

    </Grid>


</ContentPage>
